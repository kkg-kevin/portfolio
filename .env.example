# Copy this file to .env.local for local development.
# Set the same variables in the Vercel and Netlify dashboards for deployments.

# Formspree form ID: the part after /f/ in https://formspree.io/f/xxxxxxxx
# Public identifier, not a secret. Leave empty to use the email fallback.
VITE_FORMSPREE_FORM_ID=

# Canonical site origin, no trailing slash, e.g. https://kevingithinji.dev
# Used for canonical links, Open Graph URLs, robots.txt and sitemap.xml.
# If empty, the build uses the host's own production URL.
VITE_SITE_URL=
